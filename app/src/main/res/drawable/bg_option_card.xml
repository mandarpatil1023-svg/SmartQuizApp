<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="#102A3F" />
            <corners android:radius="20dp" />
            <stroke
                android:width="2dp"
                android:color="@color/accentSky" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#0D1A2D" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#1C3550" />
        </shape>
    </item>
</selector>
